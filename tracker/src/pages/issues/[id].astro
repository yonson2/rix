---
import { getCollection, render } from 'astro:content';
import Shell from '../../layouts/shell.astro';
import Progress from '../../components/progress.astro';
import { displayTitle, labelOf, loadBoard, toneOf } from '../../lib/board';
import type { Issue } from '../../lib/issues';

export async function getStaticPaths() {
  const entries = await getCollection('issues');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const issue: Issue = entry.data;
const board = await loadBoard();

const deps = issue.dependsOn.map((id) => board.byId.get(id)).filter((d) => d !== undefined);
const blockers = board.blockedBy.get(issue.id) ?? [];
const cleared = deps.filter((dep) => dep.status === 'done').length;

/** Titles repeat the milestone that the facts table already carries. */
const trim = displayTitle;

/** The raw line is only worth printing when it says more than the ids do. */
const note = issue.dependsOnNote ?? '';
const noteAddsSomething = note.replace(/\[\d{3}\]/g, '').replace(/[\s,;.]/g, '') !== '';

const chip = (other: Issue) => ({
  id: other.id,
  title: trim(other),
  href: `/issues/${other.id}/`,
  tone: toneOf(other.status),
});
---

<Shell title={`[${issue.id}] ${issue.title} - Rix`} description={issue.title}>
  <div class="page" style={toneOf(issue.status)}>
    <nav class="crumbs">
      <a href="/">&larr; Board</a>
      <a href="/issues/">Milestones</a>
      <span class="status">{labelOf(issue.status)}</span>
      {issue.desync && <span class="desync">file says {issue.declaredStatus}</span>}
    </nav>

    <header class="masthead">
      <p class="id">{issue.id}</p>
      <h1>{trim(issue)}</h1>
    </header>

    <dl class="facts">
      <div>
        <dt class="label">Milestone</dt>
        <dd>{issue.milestone ?? '-'}</dd>
      </div>
      <div>
        <dt class="label">Created</dt>
        <dd>{issue.created ?? '-'}</dd>
      </div>
      <div>
        <dt class="label">Closed</dt>
        <dd>{issue.closed ?? '-'}</dd>
      </div>
    </dl>

    <section class="links">
      <div class="link-box">
        <h2 class="label">Depends on</h2>
        {
          deps.length === 0 ? (
            <p class="none">{issue.dependsOnNote ?? 'Nothing.'}</p>
          ) : (
            <>
              <ul class="chips">
                {deps.map(chip).map((dep) => (
                  <li>
                    <a href={dep.href} style={dep.tone}>
                      <i />
                      <b>{dep.id}</b>
                      <span>{dep.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <Progress
                value={cleared}
                total={deps.length}
                size="sm"
                label={`${cleared} of ${deps.length} dependencies closed`}
              />
              <p class="gauge">{cleared} of {deps.length} cleared</p>
              {noteAddsSomething && <p class="verbatim">{note}</p>}
            </>
          )
        }
      </div>

      <div class="link-box">
        <h2 class="label">Required by</h2>
        {
          blockers.length === 0 ? (
            <p class="none">Nothing waits on this.</p>
          ) : (
            <ul class="chips">
              {blockers.map(chip).map((other) => (
                <li>
                  <a href={other.href} style={other.tone}>
                    <i />
                    <b>{other.id}</b>
                    <span>{other.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <article class="sheet">
      <Content />
    </article>

    <footer class="tail">
      <a href="/">&larr; Board</a>
      <a href="/issues/">Milestones</a>
      <p>Source: <code>issues/{issue.status}/{issue.id}-*.md</code></p>
    </footer>
  </div>
</Shell>

<style>
  .page {
    max-width: 1080px;
    margin-inline: auto;
    padding: var(--s5) var(--s5) var(--s8);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .crumbs a,
  .tail a {
    padding: var(--s1) var(--s3);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    color: var(--text-2);
    text-decoration: none;
  }

  .crumbs a:hover,
  .tail a:hover {
    border-color: var(--line);
    color: var(--ink);
  }

  .status,
  .desync {
    padding: var(--s1) var(--s3);
    border-radius: var(--r);
    font-weight: 700;
    color: var(--black);
  }

  .status {
    background: var(--accent);
  }

  .desync {
    background: var(--alarm);
  }

  .masthead {
    display: flex;
    align-items: baseline;
    gap: var(--s5);
    margin-top: var(--s5);
  }

  .id {
    margin: 0;
    font-size: clamp(44px, 7vw, 72px);
    font-weight: 800;
    line-height: 0.9;
    color: var(--accent);
    text-shadow: 0 0 18px color-mix(in srgb, var(--accent) 45%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .masthead h1 {
    margin: 0;
    font-size: clamp(20px, 2.6vw, 28px);
    font-weight: 700;
    line-height: 1.25;
    color: var(--white);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    margin: var(--s5) 0 0;
    padding: var(--s3) var(--s2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--panel);
  }

  .facts > div {
    padding: var(--s1) var(--s4);
  }

  .facts > div + div {
    border-left: 1px solid var(--line-soft);
  }

  .facts dd {
    margin: var(--s1) 0 0;
    font-size: 14px;
    font-weight: 700;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s4);
    margin-top: var(--s4);
  }

  .link-box {
    padding: var(--s4);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    background: var(--tint);
  }

  .link-box h2 {
    margin-bottom: var(--s3);
    color: var(--accent);
  }

  .chips {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    margin: 0 0 var(--s3);
    padding: 0;
    list-style: none;
  }

  .chips a {
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--s3);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    font-size: 13px;
  }

  .chips a:hover {
    border-color: var(--accent);
  }

  .chips i {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .chips b {
    font-size: 12px;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .chips span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gauge {
    margin: var(--s2) 0 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .none,
  .verbatim {
    margin: 0;
    font-size: 13px;
    color: var(--text-2);
  }

  .verbatim {
    margin-top: var(--s3);
    padding-left: var(--s3);
    border-left: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
    line-height: 1.6;
  }

  /* The document itself: plain text on the panel, quieter than the board around it. */
  .sheet {
    max-width: 820px;
    margin: var(--s6) auto 0;
    padding: var(--s6) clamp(var(--s4), 5vw, var(--s7));
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    background: var(--panel);
  }

  .tail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    max-width: 820px;
    margin: var(--s5) auto 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .tail p {
    margin: 0 0 0 auto;
    letter-spacing: 0;
    text-transform: none;
  }

  .sheet :global(> :first-child) {
    margin-top: 0;
  }

  .sheet :global(h2) {
    margin: var(--s6) 0 var(--s3);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
  }

  .sheet :global(h2)::after {
    content: '';
    display: block;
    width: 40px;
    height: 2px;
    margin-top: var(--s2);
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .sheet :global(h3) {
    margin: var(--s5) 0 var(--s2);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sheet :global(p),
  .sheet :global(li) {
    font-size: 14px;
    line-height: 1.7;
  }

  .sheet :global(ul),
  .sheet :global(ol) {
    padding-left: var(--s5);
  }

  .sheet :global(li) {
    margin-bottom: var(--s2);
  }

  .sheet :global(li::marker) {
    color: var(--accent);
  }

  .sheet :global(code) {
    padding: 1px 4px;
    border-radius: var(--r);
    background: var(--raised);
    color: var(--white);
    font-size: 13px;
  }

  .sheet :global(pre) {
    overflow-x: auto;
    padding: var(--s4);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    background: var(--black) !important;
    font-size: 13px;
    line-height: 1.6;
  }

  .sheet :global(pre code) {
    padding: 0;
    background: none;
  }

  /* An issue reference inside the prose reads as a link to another sheet. */
  .sheet :global(a) {
    color: var(--cyan);
    font-weight: 700;
    text-decoration: underline 1px;
    text-underline-offset: 3px;
  }

  .sheet :global(a:hover) {
    text-shadow: 0 0 8px rgb(86 180 255 / 0.6);
  }

  .sheet :global(strong) {
    font-weight: 700;
    color: var(--white);
  }

  .sheet :global(blockquote) {
    margin: var(--s4) 0;
    padding-left: var(--s4);
    border-left: 2px solid var(--line);
    color: var(--text-2);
  }

  .sheet :global(table) {
    border-collapse: collapse;
    font-size: 13px;
  }

  .sheet :global(th),
  .sheet :global(td) {
    padding: var(--s1) var(--s3);
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
  }

  @media (max-width: 900px) {
    .page {
      padding-inline: var(--s4);
    }
    .masthead {
      flex-direction: column;
      gap: var(--s2);
    }
  }

  @media (max-width: 640px) {
    .facts > div + div {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
      padding-top: var(--s3);
      margin-top: var(--s2);
    }
  }
</style>
